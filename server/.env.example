# Spotify app credentials — https://developer.spotify.com/dashboard
# Redirect URI on the app must be exactly: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Anthropic API key — https://platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── deployment only (leave unset for local dev) ──────────────────────
# HOST=0.0.0.0                 # container hosts need a non-loopback bind
# CLIENT_URL=/                 # post-OAuth redirect; "/" once Express serves the client
# SPOTIFY_REDIRECT_URI=https://<your-app-host>/callback   # must match the dashboard
# APP_SECRET=                  # optional shared key; unset = public mode, caps bound the spend
# SPOTIFY_REFRESH_TOKEN=       # the OWNER's token, from a completed login; powers catalog
#                              # search and survives ephemeral-disk resets
# SPOTIFY_HOST_REFRESH_TOKEN=  # the MIXTAPE host account's token — every mixtape is pressed
#                              # into this account, public, so anyone can keep it with one
#                              # tap. Unset = the owner's account hosts them.
# DAILY_GENERATIONS_PER_USER=25  # per-account generate/adjust cap (the Anthropic key and
#                                # Spotify's daily quota are shared by everyone)
# GUEST_DAILY_CAP=5            # per guest browser (visitors who never connect Spotify)
# GUEST_IP_DAILY_CAP=10        # per IP, across guest cookies
# GUEST_TOTAL_DAILY_CAP=12     # all guests together — the number that bounds the bill
