# Spotify app credentials — https://developer.spotify.com/dashboard
# Redirect URI on the app must be exactly: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Anthropic API key — https://platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── deployment only (leave unset for local dev) ──────────────────────
# HOST=0.0.0.0                 # container hosts need a non-loopback bind
# CLIENT_URL=/                 # post-OAuth redirect; "/" once Express serves the client
# SPOTIFY_REDIRECT_URI=https://<your-app-host>/callback   # must match the dashboard
# APP_SECRET=                  # owner key gating every request — REQUIRED off-loopback
# SPOTIFY_REFRESH_TOKEN=       # from a completed login; survives ephemeral-disk resets
