{
  "name": "mixtape-factory-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only visualization of Mixtape feature-factory workflow runs. Never deployed.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/register-ts.mjs --test \"src/**/*.test.ts\"",
    "fixtures": "node fixtures/redact.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dagrejs/dagre": "^3.0.0",
    "@lezer/highlight": "^1.2.3",
    "@xyflow/react": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.6"
